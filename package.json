{
  "name": "aigc-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "cross-env VITE_DEV_WEB=true vite",
    "build": "vite build",
    "build:electron": "cross-env ELECTRON=true vite build && electron-builder",
    "build:win": "cross-env ELECTRON=true vite build && node scripts/clean-release.cjs && electron-builder --win",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "sherpa-onnx": "^1.13.2",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/ui": "^4.1.4",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.0.2",
    "vite": "^8.0.4",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^4.1.4"
  },
  "build": {
    "appId": "com.aigc.app",
    "productName": "AIGC App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "win": {
      "executableName": "AIGCApp",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
